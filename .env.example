# Required in production. On Vercel, /api/vote answers 503 until blob credentials,
# IP_HASH_SALT and HOLD_VERIFY_SECRET are all present. A Blob store attached over OIDC
# supplies VERCEL_OIDC_TOKEN + BLOB_STORE_ID in place of the token below.
BLOB_READ_WRITE_TOKEN=
IP_HASH_SALT=
HOLD_VERIFY_SECRET=

# Optional. PRUNE_SECRET guards POST /api/prune-votes; leave it unset and that route
# deletes nothing. LOCAL_VOTE_DIR is for local API testing only, never set it in Vercel.
# CAPYBARA_ARENA_URL is the deployment the pull and backup scripts default to.
PRUNE_SECRET=
LOCAL_VOTE_DIR=
CAPYBARA_ARENA_URL=
