{
  "name": "cad_grade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dataset": "node scripts/build-dataset.mjs",
    "check:dataset": "node scripts/check-dataset.mjs",
    "check:production": "node scripts/check-production.mjs",
    "backup:live": "node scripts/backup-live.mjs",
    "backup:test-click": "node scripts/backup-test-click.mjs",
    "backup:install-hourly": "bash scripts/install-hourly-backup-macos.sh",
    "backup:uninstall-hourly": "bash scripts/uninstall-hourly-backup-macos.sh",
    "backup:install-hourly:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-hourly-backup.ps1",
    "backup:uninstall-hourly:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/unregister-hourly-backup.ps1",
    "process:data": "node scripts/process-data.mjs",
    "pull:data": "node scripts/pull-data.mjs",
    "pull:votes": "node scripts/pull-votes.mjs",
    "serve:trends": "node scripts/serve-trends.mjs",
    "playwright": "node scripts/browser-smoke.mjs",
    "playwright:test": "playwright test",
    "capture:screenshot": "node scripts/capture-arena-screenshot.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.29",
    "@types/three": "^0.165.0",
    "@vercel/node": "^5.1.14",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
